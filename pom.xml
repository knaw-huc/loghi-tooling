<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nl.knaw.huc.di.images</groupId>
    <artifactId>loghi-tooling</artifactId>
    <version>2.1.0</version>
    <modules>
        <!-- NB (prompt-dependency-audit-2026-09-06): the prima-core-libs sibling checkout is
             not present in this environment, so these 4 modules are disabled and the Prima
             1.0-SNAPSHOT artifacts are resolved from the in-project file repository
             (file:///${user.home}/repo) instead. Re-enable (and remove the seeded repo)
             when building with a full prima-core-libs checkout. -->
        <!-- <module>../prima-core-libs/java/PrimaMaths/</module>
        <module>../prima-core-libs/java/PrimaBasic/</module>
        <module>../prima-core-libs/java/PrimaIo/</module>
        <module>../prima-core-libs/java/PrimaDla/</module> -->
        <module>stringtools</module>
        <module>altoxmlutils</module>
        <module>pagexmlutils</module>
        <module>imageanalysiscommon</module>
        <module>layoutds</module>
        <module>minions</module>
        <module>layoutanalyzer</module>
        <module>loghiwebservice</module>
    </modules>

    <repositories>
        <repository>
            <id>in-project</id>
            <name>In Project Repo</name>
            <url>file:///${user.home}/repo</url>
        </repository>
    </repositories>

    <packaging>pom</packaging>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>10.0.2</version>
                <configuration>
                    <failBuildOnCVSS>8</failBuildOnCVSS>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <properties>
        <!-- 2026-09-06 dependency audit: jackson bumped 2.16.1 -> 2.22.2 (CVE-2026-59888,
             CVE-2026-54512/13/14 fixed in 2.18.8; CVE-2026-18401 fixed in 2.18.8),
             commons-lang3 3.14.0 -> 3.20.0 (CVE-2025-48924 fixed in 3.18.0),
             log4j 2.26.0 -> 2.26.1 (CVE-2026-49844 fixed in 2.26.1),
             guava 32.1.1-jre -> 33.7.1-jre, junit5 5.9.1 -> 5.14.4,
             commons-io pinned [2.14.0,) -> 2.22.0, unused joda-time.version removed.
             See DEPS-TODO-2026-09-06.md for deferred upgrades. -->
        <jackson.version>2.22.2</jackson.version>
        <commons-io.version>2.22.0</commons-io.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <guava.version>33.7.1-jre</guava.version>
        <slf4j.version>1.7.36</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <junit4.version>4.13.2</junit4.version>
        <junit5.version>5.14.4</junit5.version>
        <hibernate.version>5.6.15.Final</hibernate.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Common utility libs (DEP-02 / DEP-03 / DEP-04) -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <!-- Testing -->
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit4.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit5.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
